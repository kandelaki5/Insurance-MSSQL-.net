# Copy to .env.test (ignored by git) and fill in. Integration and browser tests create their own database
# (name starting with ins_it_) on this server and drop it afterwards; they never touch any other database.
INSURANCE_TEST_SQL_MASTER="Server=localhost,1433;User ID=sa;Password=<local test server password>;TrustServerCertificate=True;Encrypt=True"
# Optional: an old-program database built by tests/parity/legacy-world/build-world.ts. Without it the data migration
# tests are reported as skipped (not passed).
INSURANCE_TEST_PG_WORLD="Host=localhost;Port=5432;Database=insurance_world;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true"
