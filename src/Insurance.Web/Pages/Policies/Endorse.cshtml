@page "/policies/{id:guid}/endorse"
@model Insurance.Web.Pages.Policies.EndorseModel
@using N = Insurance.Application.Texts.PolicyTexts.Endorse
@{
    ViewData["Title"] = N.Title;
    var id = RouteData.Values["id"];
}
<h1>@N.Title: @Model.Number</h1>
<p class="note">@N.Note</p>
<form method="post" data-premium-total="delta" data-total-suffix=" @Model.Currency">
    @if (Model.FormError is not null)
    {
        <div class="alert error">@Model.FormError</div>
    }
    <input type="hidden" name="policy_id" value="@id" />

    <div class="card">
        <div class="grid">
            <div>
                <label for="change_on">@N.ChangeOn</label>
                <date-input id="change_on" name="change_on" value="@Model.Value("change_on")" min="@Fmt.Iso(Model.MinDate)" max="@Fmt.Iso(Model.MaxDate)" required />
                @if (Model.Error("change_on") is { } dateError)
                {
                    <div class="field-error">@dateError</div>
                }
                else
                {
                    <div class="hint">@N.DateHint</div>
                }
            </div>
            <div class="wide">
                <label for="reason">@N.Reason</label>
                <input id="reason" name="reason" type="text" value="@Model.Value("reason")" required />
                @if (Model.Error("reason") is { } reasonError)
                {
                    <div class="field-error">@reasonError</div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <h2>@N.CoveragesTitle</h2>
        <p class="note">@N.CoveragesNote</p>
        @if (Model.Error("coverages") is { } coveragesError)
        {
            <div class="field-error">@coveragesError</div>
        }
        <table class="plain">
            <thead>
            <tr>
                <th></th>
                <th>@PolicyTexts.Fields.Coverage</th>
                <th>@N.Current</th>
                <th>@N.NewLimit</th>
                <th>@N.NewDeductible</th>
                <th>@N.PremiumDelta, @Model.Currency</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Coverages)
            {
                <tr>
                    <td><input type="checkbox" name="cov_@(c.Code)_on" aria-label="@c.Name" data-code="@c.Code" data-mandatory="0" checked="@(Model.Value($"cov_{c.Code}_on") == "on")" /></td>
                    <td>@c.Name<div class="hint">@c.ClassCode</div></td>
                    <td class="hint">@(c.Included ? $"{N.LimitShort} {c.CurrentLimit} · {N.DeductibleShort} {c.CurrentDeductible} · {N.PremiumShort} {c.CurrentPremium}" : N.NotIncluded)</td>
                    <td><input name="cov_@(c.Code)_limit" type="number" step="0.01" min="0" aria-label="@($"{c.Name}: {N.NewLimit}")" value="@Model.Value($"cov_{c.Code}_limit")" /></td>
                    <td><input name="cov_@(c.Code)_deductible" type="number" step="0.01" min="0" aria-label="@($"{c.Name}: {N.NewDeductible}")" value="@Model.Value($"cov_{c.Code}_deductible")" /></td>
                    <td><input name="cov_@(c.Code)_delta" type="number" step="0.01" aria-label="@($"{c.Name}: {N.PremiumDelta}")" value="@Model.Value($"cov_{c.Code}_delta")" /></td>
                </tr>
            }
            </tbody>
        </table>
        <p class="total" data-total hidden>@N.TotalDelta: <strong></strong></p>
    </div>

    <div class="toolbar">
        <button class="btn">@N.Submit</button>
        <a class="btn secondary" href="/policies/@id">@Ka.Common.Cancel</a>
    </div>
</form>
@section Scripts {
    <script src="~/js/premium-total.js" asp-append-version="true"></script>
}
