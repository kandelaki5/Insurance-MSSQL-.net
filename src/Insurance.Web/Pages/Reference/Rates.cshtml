@page "/reference/rates"
@model Insurance.Web.Pages.Reference.RatesModel
@{
    ViewData["Title"] = Ka.Rates.Title;
    string Rate(decimal? value) => value is { } v ? Fmt.Fixed(v, 4) : "—";
}
<h1>@Ka.Rates.Title</h1>
<p class="note">@Ka.Rates.Note</p>
@if (Model.Me.CanWrite)
{
    @if (Model.FormError is not null)
    {
        <div class="alert error">@Model.FormError</div>
    }
    @if (Model.Notice is not null)
    {
        <div class="alert ok">@Model.Notice</div>
    }
    <form method="post" class="toolbar">
        <div>
            <label for="date">@Ka.Rates.Date</label>
            <date-input id="date" name="date" value="@Model.Value("date", Model.Today)" max="@Model.Today" required />
        </div>
        <button class="btn" style="align-self: flex-end">@Ka.Rates.Load</button>
    </form>
}
@if (Model.Rows.Count == 0)
{
    <div class="card empty">@Ka.Common.NoData</div>
}
else
{
    <table style="max-width: 480px">
        <thead>
        <tr>
            <th>@Ka.Rates.Date</th>
            <th class="num">USD</th>
            <th class="num">EUR</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@Fmt.Date(row.RateDate)</td>
                <td class="num">@Rate(row.Usd)</td>
                <td class="num">@Rate(row.Eur)</td>
            </tr>
        }
        </tbody>
    </table>
}
