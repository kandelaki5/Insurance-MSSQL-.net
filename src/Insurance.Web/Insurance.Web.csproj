<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Insurance.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Insurance.Application\Insurance.Application.csproj" />
    <!-- The composition root (ADR 0001): the host serves the Razor pages, the Angular build and the API in one site. -->
    <ProjectReference Include="..\Insurance.Api\Insurance.Api.csproj" />
    <ProjectReference Include="..\Insurance.Infrastructure\Insurance.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR 0003: the embedded OpenID Connect provider over the program's own users, the API's bearer tokens, Swagger UI. -->
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>
</Project>
