<Project Sdk="Microsoft.NET.Sdk">
  <!-- Use cases and database access (MS SQL Server through Microsoft.Data.SqlClient + Dapper). -->
  <PropertyGroup>
    <RootNamespace>Insurance.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Insurance.Domain\Insurance.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- SqlClient 7.1.1 brings Pkcs 9.0.18, which has known advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\database\migrations\*.sql" LinkBase="Migrations" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
